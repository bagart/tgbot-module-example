{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/tgbot-module-example",
    "description": "Example module for the Telegram bot platform: demonstrates processors, commands, validation rules and outbound middleware without core edits",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "tg-bot",
        "telegram-bot",
        "bot-platform",
        "module",
        "example"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bagart/telegram-bot-lib": "*"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\TelegramBotExample\\": "src/"
        }
    },
    "scripts": {
        "test": "@php ../../../vendor/bin/pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
